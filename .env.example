# V-World (국토교통부 공간정보 오픈플랫폼) — 배경지도 타일 프록시 + 자료 빌드(대표지번 지오코딩)
# 발급: https://www.vworld.kr → 오픈API → 인증키 발급 (서비스 URL 에 배포 도메인 등록)
VWORLD_API_KEY=
# 인증키에 등록한 서비스 도메인 (Referer 로 전송). 예: site-law.vercel.app
VWORLD_DOMAIN=localhost

# (선택) 서울 열린데이터광장 의제처리구역 파일 순번 — 데이터셋 페이지의 downloadFile('N')
# SEOUL_UQ181_SEQ=9

# HAENGLIM 허브(홈 버튼) 주소
NEXT_PUBLIC_HUB_URL=https://haenglim-hub.vercel.app

# 부서 공용 접속 코드. 비우면 누구나 접속 가능
ACCESS_CODE=
# 공공데이터포털 인증키 (국토부 건축HUB 건축물대장정보 서비스) — 자료 빌드에서 준공 확정에 사용
DATA_GO_KR_KEY=
